{
  "name": "@guardrail-sim/mcp-server",
  "version": "1.0.0",
  "description": "MCP server exposing evaluate_policy tool for AI agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "guardrail-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jeffgreendesign/guardrail-sim.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/jeffgreendesign/guardrail-sim/tree/main/packages/mcp-server",
  "bugs": {
    "url": "https://github.com/jeffgreendesign/guardrail-sim/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "guardrail-sim",
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "pricing",
    "policy"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "start": "node dist/index.js",
    "test": "node --test test/*.test.ts",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@guardrail-sim/insights": "workspace:*",
    "@guardrail-sim/policy-engine": "workspace:*",
    "@guardrail-sim/simulation": "workspace:*",
    "@guardrail-sim/ucp-types": "workspace:*",
    "@modelcontextprotocol/core": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.10.1",
    "c8": "^12.0.0",
    "typescript": "^6.0.3"
  }
}
